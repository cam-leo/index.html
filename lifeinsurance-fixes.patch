+# ---- Data loading -------------------------------------------------------
+# Life tables come from the Human Mortality Database (https://mortality.org),
+# Canada, period 1x1. Put the raw HMD files in a `data/` folder next to this
+# file. If the combined (both sexes) file isn't there, the bundled
+# life_table.rds (same data, already cleaned) is used instead.
+read_hmd <- function(file) {
+  lt <- read.table(file, header = TRUE, skip = 2, stringsAsFactors = FALSE)
+  colnames(lt) <- c("Year", "Age", "mx", "qx", "ax", "lx", "dx", "Lx", "Tx", "ex")
+  lt$Age <- as.numeric(sub("+", "", lt$Age, fixed = TRUE))  # "110+" -> 110
+  lt[] <- lapply(lt, as.numeric)
+  lt
+}
+
+load_life_table <- function(sex = c("both", "male", "female")) {
+  sex <- match.arg(sex)
+  file <- file.path("data", c(both = "bltper_1x1.txt", male = "mltper_1x1.txt",
+                              female = "fltper_1x1.txt")[[sex]])
+  if (file.exists(file)) return(read_hmd(file))
+  if (sex == "both" && file.exists("life_table.rds")) {
+    lt <- readRDS("life_table.rds")
+    lt$Age[is.na(lt$Age)] <- 110  # the open age group "110+" was stored as NA
+    return(lt)
+  }
+  NULL
+}
+
+life_table_all <- load_life_table("both")
+if (is.null(life_table_all)) stop("No life table found: add data/bltper_1x1.txt or life_table.rds")
+life_table_2021 <- subset(life_table_all, Year == 2021)
+
+life_table_m_all <- load_life_table("male")
+life_table_f_all <- load_life_table("female")
+has_sex_tables <- !is.null(life_table_m_all) && !is.null(life_table_f_all)
 ```
 
