 }
 
 .content-wrapper {
-  max-width: 1400px;
+  max-width: 1800px;
+}
+
+/* ---- Math ------------------------------------------------------------------ */
+.katex { font-size: 1.08em; }
+
+.katex-display {
+  margin: 1.1em 0 1.4em;
+  padding: 14px 18px;
+  background: var(--navy-50);
+  border-left: 3px solid var(--navy-500);
+  border-radius: 4px;
+  overflow-x: auto;
+  overflow-y: hidden;
+}
+
+/* ---- Callouts (the expandable explanations) ----------------------------- */
+details {
+  margin: 1.2em 0;
+  padding: 0 18px;
+  background: var(--navy-50);
+  border: 1px solid var(--line);
+  border-left: 3px solid var(--navy-500);
+  border-radius: 6px;
+}
+
+details > summary {
+  padding: 12px 0;
+  color: var(--navy-700);
+  font-weight: 600;
+  cursor: pointer;
+}
+
+details[open] > summary {
+  border-bottom: 1px solid var(--line);
+  margin-bottom: 12px;
+}
+
+details p,
+details > :not(summary) {
+  color: var(--ink);
+  font-weight: 400;
+}
+
+details[open] {
+  padding-bottom: 6px;
