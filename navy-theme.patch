diff --git a/docs/combined.css b/docs/combined.css
index 49c2097..18da91c 100644
--- a/docs/combined.css
+++ b/docs/combined.css
@@ -1,24 +1,124 @@
+/* =========================================================================
+   Life Insurance Analysis: navy theme
+   ========================================================================= */
+@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap");
+
+:root {
+  --navy-900: #0b2545;   /* sidebar, title */
+  --navy-700: #13315c;   /* headings */
+  --navy-500: #1d4e89;   /* links, accents */
+  --navy-100: #e8eef7;   /* tints */
+  --navy-50:  #f3f6fb;
+  --ink:      #1f2933;   /* body text */
+  --muted:    #52606d;
+  --line:     #d9e2ec;
+  --page:     #ffffff;
+}
+
+/* ---- Base ---------------------------------------------------------------- */
+html, body {
+  background: var(--page);
+}
+
 body {
-  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
-  line-height: 1.6;
-  color: #333;
-  background-color: #f8f9fa;
-  font-size: 18px;
+  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  font-size: 17px;
+  line-height: 1.7;
+  color: var(--ink);
   margin: 0;
   padding: 0;
+  -webkit-font-smoothing: antialiased;
+}
+
+p { margin: 0 0 1em; }
+
+a { color: var(--navy-500); }
+a:hover, a:focus { color: var(--navy-900); }
+
+strong { font-weight: 600; }
+
+hr {
+  border: 0;
+  border-top: 1px solid var(--line);
+  margin: 2.2em 0;
+}
+
+/* ---- Title block ---------------------------------------------------------- */
+#header {
+  margin: 10px 0 30px;
+  padding-bottom: 24px;
+  border-bottom: 3px solid var(--navy-900);
+}
+
+h1.title {
+  font-size: 44px;
+  font-weight: 700;
+  color: var(--navy-900);
+  letter-spacing: -0.02em;
+  margin: 0 0 10px;
+  padding: 0;
+  border: 0;
+}
+
+h4.author, h4.date {
+  font-size: 17px;
+  font-weight: 500;
+  color: var(--muted);
+  margin: 4px 0;
+}
+
+h4.author a { color: var(--navy-500); }
+
+/* ---- Headings ------------------------------------------------------------- */
+h1, h2, h3, h4, h5, h6 {
+  font-family: inherit;
+  color: var(--navy-700);
+  font-weight: 600;
+  letter-spacing: -0.01em;
+  line-height: 1.3;
 }
 
-/* ---- Desktop layout: fixed contents sidebar on the left, wide content on the right ---- */
+h1 {                       /* part titles: Cash Flows, Life Tables, ... */
+  font-size: 34px;
+  font-weight: 700;
+  color: var(--navy-900);
+  margin-top: 2.2em;
+  padding-bottom: 10px;
+  border-bottom: 1px solid var(--line);
+}
+h2 { font-size: 27px; margin-top: 1.9em; }
