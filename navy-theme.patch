+  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  font-size: 17px;
+  line-height: 1.7;
+  color: var(--ink);
   margin: 0;
   padding: 0;
+  -webkit-font-smoothing: antialiased;
+}
+
+p { margin: 0 0 1em; }
+
+a { color: var(--navy-500); }
+a:hover, a:focus { color: var(--navy-900); }
+
+strong { font-weight: 600; }
+
+hr {
+  border: 0;
+  border-top: 1px solid var(--line);
+  margin: 2.2em 0;
+}
+
+/* ---- Title block ---------------------------------------------------------- */
+#header {
+  margin: 10px 0 30px;
+  padding-bottom: 24px;
+  border-bottom: 3px solid var(--navy-900);
+}
+
+h1.title {
+  font-size: 44px;
+  font-weight: 700;
+  color: var(--navy-900);
+  letter-spacing: -0.02em;
+  margin: 0 0 10px;
+  padding: 0;
+  border: 0;
+}
+
+h4.author, h4.date {
+  font-size: 17px;
+  font-weight: 500;
+  color: var(--muted);
+  margin: 4px 0;
+}
+
+h4.author a { color: var(--navy-500); }
+
+/* ---- Headings ------------------------------------------------------------- */
+h1, h2, h3, h4, h5, h6 {
+  font-family: inherit;
+  color: var(--navy-700);
+  font-weight: 600;
+  letter-spacing: -0.01em;
+  line-height: 1.3;
 }
 
-/* ---- Desktop layout: fixed contents sidebar on the left, wide content on the right ---- */
