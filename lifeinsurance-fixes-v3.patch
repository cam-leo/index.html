+<span id="cb203-4"><a href="#cb203-4" tabindex="-1"></a><span class="fu">lines</span>(adults_2021<span class="sc">$</span>Age, <span class="fu">fitted</span>(gompertz) <span class="sc">/</span> adults_2021<span class="sc">$</span>Lx, <span class="at">col =</span> <span class="st">&quot;red&quot;</span>, <span class="at">lwd =</span> <span class="dv">2</span>)</span>
