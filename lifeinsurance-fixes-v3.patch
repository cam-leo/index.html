-n_bootstrap <- 1000
-bootstrap_pvs <- replicate(n_bootstrap, {
-  sampled_cash_flows <- sample(cash_flows, replace = TRUE)
-  sum(sampled_cash_flows * discount_factors)
-})
+n_sim <- 10000
+rates <- rnorm(n_sim, mean = 0.0214, sd = 0.005)
+pv_sim <- sapply(rates, function(r) sum(cash_flows * (1 + r) ^ -(0:5)))
 
-# Calculate 95% confidence interval
-ci <- quantile(bootstrap_pvs, c(0.025, 0.975))
-cat("95% Confidence Interval for PV:", ci)
+cat("Middle 95% of the required deposit:", round(quantile(pv_sim, c(0.025, 0.975)), 2), "\n")
+cat("Probability that a $20,000 deposit is enough:", mean(pv_sim <= 20000), "\n")
 
+# Interest rate at which exactly $20,000 is needed
+breakeven_rate <- uniroot(function(r) sum(cash_flows * (1 + r) ^ -(0:5)) - 20000, c(-0.05, 0.2))$root
+cat("$20,000 is enough whenever the rate is at least", round(100 * breakeven_rate, 3), "%\n")
 
+hist(pv_sim, breaks = 50, main = "Required deposit under interest-rate uncertainty",
+     xlab = "Deposit needed today")
+abline(v = c(present_val, 20000), col = c("red", "blue"), lwd = 2, lty = c(1, 2))
+legend("topright", c("PV at 2.14%", "$20,000"), col = c("red", "blue"), lty = c(1, 2), lwd = 2)
 ```
 
